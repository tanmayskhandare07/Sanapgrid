{
  "name": "snapgrid",
  "version": "1.0.0",
  "description": "SnapGrid — Mini Instagram Clone for DBMS Project (MySQL + Express + React)",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "setup": "npm run install:all && node database/init_db.js",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "backend:start": "npm --prefix backend start",
    "frontend:build": "npm --prefix frontend run build",
    "vercel-build": "npm --prefix frontend install && npm --prefix frontend run build",
    "db:setup": "node database/init_db.js",
    "start": "start-dev.bat"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.24.5"
  },
  "keywords": [
    "snapgrid",
    "instagram-clone",
    "mysql",
    "dbms",
    "express",
    "react",
    "vite",
    "fullstack"
  ],
  "author": "Aditya Kharat",
  "license": "MIT"
}
